# ─────────────────────────────────────────────────────────────
# .env.test.example — แม่แบบสำหรับชุดทดสอบ Playwright (สัปดาห์ที่ 9)
#
# คัดลอกไฟล์นี้เป็น .env.test แล้วใส่ค่าจริง (.env.test ถูกกันไว้ใน
# .gitignore แล้ว จะไม่ขึ้น GitHub) ต้องมีบัญชีทดสอบ Firebase Auth
# จริงตามนี้ก่อนจึงจะรันชุดทดสอบได้:
#   - EMPLOYEE1/EMPLOYEE2: บัญชี role "employee" ธรรมดา 2 บัญชี
#   - MANAGER: บัญชี role "manager" (ต้องตั้ง role เองใน Firebase Console
#     เพราะสมัครผ่านหน้าเว็บได้แค่ role employee เท่านั้น)
# ─────────────────────────────────────────────────────────────

BASE_URL=https://leaveeasy-nan.web.app

TEST_EMPLOYEE1_EMAIL=
TEST_EMPLOYEE1_PASSWORD=

TEST_EMPLOYEE2_EMAIL=
TEST_EMPLOYEE2_PASSWORD=

TEST_MANAGER_EMAIL=
TEST_MANAGER_PASSWORD=
